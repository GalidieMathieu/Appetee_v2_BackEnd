{
    "ConnectionStrings": {
        "AppeteeDb": ""
    },
    "AzureStorage": {
        "AccountUrl": "https://appeteeimages.blob.core.windows.net",
        "ContainerName": ""
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "Authentication": {
        "CookieName": "__Host-appetee",
        "ExpireDays": 14,
        "SlidingExpiration": true
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Azure": "Warning",
            "Appetee": "Information"
        },
        "Console": {
            "IncludeScopes": true
        }
    },
    "AllowedHosts": "*"
}
