{
    "ConnectionStrings": {
        "AppeteeDb": ""
    },
    "AzureStorage": {
        "AccountUrl": "https://appeteeimages.blob.core.windows.net",
        "ContainerName": ""
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "Authentication": {
        "CookieName": "__Host-appetee",
        "RememberedSessionDays": 7,
        "AbsoluteSessionDays": 30
    },
    "PasswordRecovery": {
        "TokenLifetimeMinutes": 60,
        "RequestCooldownSeconds": 60
    },
    "CommunicationEmail": {
        "Endpoint": "",
        "FromAddress": ""
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Azure": "Warning",
            "Appetee": "Information"
        },
        "Console": {
            "IncludeScopes": true
        }
    },
    "AllowedHosts": "*"
}
